# Single-database fallback. Use BIZDB_DATABASES_JSON for multiple databases.
BIZDB_MYSQL_DSN=mysql://db_user:replace-me@db-host:3306/app_db
BIZDB_DEFAULT_DATABASE=primary

BIZDB_SANDBOX_BASE_URL=http://sandbox:8000
BIZDB_SANDBOX_API_TOKEN=replace-me

# Both the global switch and a database entry's allow_writes flag are required.
BIZDB_WRITE_ENABLED=false
BIZDB_WRITE_REQUIRE_WHERE=true
BIZDB_WRITE_MAX_AFFECTED_ROWS=1000
BIZDB_WRITE_TIMEOUT_SECONDS=30

# DBPM is disabled by default. When enabled, provide a local bridge command.
BIZDB_DBPM_ENABLED=false
# BIZDB_DBPM_COMMAND=/opt/bizdb/bin/dbpm-bridge
# BIZDB_DBPM_SERVERS=172.21.72.32:7000,172.21.72.33:7000
# BIZDB_DBPM_APP_NAME=YOUR_APP
# BIZDB_DBPM_APP_KEY=file:/etc/bizdb/dbpm.key
# BIZDB_DBPM_APP_IP=127.0.0.1
# BIZDB_DBPM_CONNECT_TIMEOUT_MS=5000
# BIZDB_DBPM_READ_TIMEOUT_MS=5000
# BIZDB_DBPM_TIMEOUT_SECONDS=10

# Required only by export; injected by the trusted caller for this process.
# BIZDB_SESSION_ID=session-id
# BIZDB_ORG_ID=org-id
# BIZDB_USER_ID=user-id
# BIZDB_CONVERSATION_ID=conversation-id
